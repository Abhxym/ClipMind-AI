# ============================================================
# AI Video Director — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Gemini / Google AI ──────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_CAPTION=gemini-1.5-flash
GEMINI_MODEL_PLANNER=gemini-1.5-pro

# ── LangSmith (Tracing) ─────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-video-director
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Vector Database ─────────────────────────────────────────
VECTOR_DB_BACKEND=faiss          # faiss | chroma
FAISS_INDEX_PATH=rag/faiss_index
CHROMA_DB_PATH=rag/chroma_db
CHROMA_COLLECTION=brand_knowledge

# ── Embedding Model ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# ── RAG Settings ────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=10
TOP_K_RERANK=3

# ── Video Processing ────────────────────────────────────────
FRAME_SAMPLE_FPS=1
BLUR_THRESHOLD=30.0
BRIGHTNESS_MIN=20
BRIGHTNESS_MAX=240
MOTION_THRESHOLD=0.1
MAX_UPLOAD_SIZE_MB=500

# ── Pipeline ────────────────────────────────────────────────
MAX_AGENT_RETRIES=3
SQLITE_CHECKPOINT_PATH=pipeline/checkpoints.db

# ── FastAPI ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Paths ───────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp
MUSIC_DIR=assets/sample_music
