# ============================================================
# ClipMind AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# Everything except GOOGLE_API_KEY has a working default.

# ── Gemini / Google AI ──────────────────────────────────────
# Without a key every Gemini step falls back (BLIP/YOLO/heuristics) and the run still completes.
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash            # scene + metadata vision, and captions by default
GEMINI_MODEL_CAPTION=gemini-2.5-flash    # captions, title, hashtags
GEMINI_MODEL_PLANNER=gemini-2.5-pro      # story planner

# ── LangSmith (optional tracing) ────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=clipmind-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Embeddings, Vector DB & RAG ─────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2         # used for both indexing and querying
RERANKER_MODEL=BAAI/bge-reranker-base
VECTOR_DB_DIR=vector_db                  # per-job FAISS indexes (embedding_agent / rag_agent)
CHUNK_SIZE=512                           # words per brand-PDF chunk
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=10
TOP_K_RERANK=3

# Used only by the RAG benchmark (evaluation/benchmark.py → rag/vector_db.py)
VECTOR_DB_BACKEND=faiss                  # faiss | chroma
FAISS_INDEX_PATH=rag/faiss_index
CHROMA_DB_PATH=rag/chroma_db
CHROMA_COLLECTION=brand_knowledge

# ── Speech-to-text ──────────────────────────────────────────
WHISPER_MODEL=base                       # tiny | base | small | medium | large

# ── Video Processing ────────────────────────────────────────
FRAME_SAMPLE_FPS=1
BLUR_THRESHOLD=30.0                      # Laplacian variance below this = blurry
BRIGHTNESS_MIN=20
BRIGHTNESS_MAX=240
MAX_UPLOAD_SIZE_MB=500
CAPTION_FONT_FILE=                       # optional .ttf for burned-in captions (e.g. C:/Windows/Fonts/arial.ttf)

# ── Pipeline ────────────────────────────────────────────────
MAX_AGENT_RETRIES=3                      # max editing passes in the review loop
SQLITE_CHECKPOINT_PATH=pipeline/checkpoints.db

# ── FastAPI ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173

# ── Paths ───────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MUSIC_DIR=api/assets/music               # track1.mp3 … track5.mp3 for the Studio
